# Local demo key. Replace before any shared or public deployment.
API_KEY=dev-only-change-me
# HMAC secret used to sign APPROVE permits. Replace in any real deployment.
DECISION_SECRET=dev-only-decision-secret
CORS_ORIGINS=http://127.0.0.1:8742,http://localhost:8742
AUDIT_DB_PATH=data/audit.db
SANDBOX_DB_PATH=data/sandbox.db
# ollama | mock. Use mock when Qwen3:4B cannot be hosted.
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TEMPERATURE=0.1
W_RULE=0.5
W_ML=0.5
THRESHOLD_APPROVE=30
THRESHOLD_HUMAN=70
RISK_MODEL_PATH=backend/ml/artifacts/risk_model.joblib
LOG_LEVEL=INFO
# Optional. Upstream ToolEmu (Ruan et al.) expects an OpenAI or Claude key.
# Point OPENAI_BASE_URL at Ollama's OpenAI-compatible API only if you have wired ToolEmu yourself.
TOOLEMU_ENABLED=0
TOOLEMU_REPO_PATH=third_party/ToolEmu
OPENAI_API_KEY=
OPENAI_BASE_URL=
EVAL_SEEDS=7,11,19

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8741
API_UPSTREAM_URL=http://127.0.0.1:8741
