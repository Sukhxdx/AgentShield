FROM node:22-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend .
RUN mkdir -p public && npm run build

FROM node:22-alpine

WORKDIR /app
RUN adduser -D -u 10001 appuser
COPY --from=build --chown=appuser:appuser /app/.next/standalone ./
COPY --from=build --chown=appuser:appuser /app/.next/static ./.next/static
COPY --from=build --chown=appuser:appuser /app/public ./public
USER appuser

ENV PORT=8742 \
    HOSTNAME=0.0.0.0

EXPOSE 8742

HEALTHCHECK --interval=15s --timeout=5s --retries=10 \
    CMD node -e "const p=process.env.PORT||8742; fetch('http://127.0.0.1:'+p).then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
